[Unit]
Description=Tool-Klipper-Calibration Machine Vision Background Service
After=network-online.target crowsnest.service klipper.service
Wants=network-online.target

[Service]
Type=simple
User=%USER%
WorkingDirectory=%REPO_DIR%
ExecStart=%VENV_DIR%/bin/python3 -m server.tool_calibrator_server --host 127.0.0.1 --port 8090 --threads 2
Restart=always
RestartSec=3s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
